{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "CNCLeaders Webshop",
    "subtitle": "custom_webshop — pages, endpoints, records, and the three apps it must live beside",
    "output": "01-architecture.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "gate",
        "label": "1 · Browse & the gate",
        "focus": [
          "apicatalog",
          "apisignup",
          "checkout",
          "dtsession",
          "localbasket",
          "login",
          "pagejs",
          "shoppages",
          "signupdomain",
          "signupjs",
          "storejs",
          "visitor",
          "websiteitem"
        ],
        "note": "Browsing and the basket need no account, and the basket lives in the visitor's own browser. Proceeding to the full form changes that."
      },
      {
        "id": "identity",
        "label": "2 · Identity",
        "focus": [
          "apisignup",
          "signupdomain",
          "dtsession",
          "dtidentity",
          "customer",
          "contact",
          "ceapp"
        ],
        "note": "Nothing in ERPNext is created until both email and phone are proved. Account Identity is the authoritative User-to-Customer link."
      },
      {
        "id": "order",
        "label": "3 · Order",
        "focus": [
          "checkout",
          "cartjs",
          "cartoverride",
          "shipping",
          "quotation",
          "salesorder",
          "orders"
        ],
        "note": "The full order form builds a Quotation, then a Sales Order that waits for payment proof rather than submitting itself."
      },
      {
        "id": "staff",
        "label": "4 · Staff review",
        "focus": [
          "signupdomain",
          "apiconflicts",
          "conflictdt",
          "customer",
          "contact"
        ],
        "note": "What the flow refuses to guess lands in a queue a person works. A merge is one-way, so the surviving record is chosen and typed to confirm."
      },
      {
        "id": "neighbours",
        "label": "5 · The apps around it",
        "focus": [
          "cartoverride",
          "apisignup",
          "contact",
          "webshopapp",
          "ceapp",
          "erpnextapp",
          "frappeapp"
        ],
        "note": "Three apps this one cannot change: webshop's cart is overridden, contact_enhancements rewrites phones on save, frappe's sign_up is closed."
      }
    ]
  },
