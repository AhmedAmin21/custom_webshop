  "cards": [
    {
      "dot": "slate",
      "title": "\"Signup stopped\" isn't the same as a withheld number",
      "items": [
        "Signup stopped means the phone or email is already the login of an existing website account — checked first, before any matching happens. Nothing is created; sign in instead",
        "A verified number sitting on someone else's Contact (not an account) never stops the signup — a new account is still made, the number is held as pending, and staff reconcile it later"
      ]
    },
    {
      "dot": "amber",
      "title": "Phone and email aren't trusted equally",
      "items": [
        "Number matches, name matches: shown a card and asked — the ordinary, confident case",
        "Number matches, name doesn't: still shown a card and asked — a verified Egyptian mobile is trusted to identify its holder on its own, even if the name on the record looks wrong",
        "Email matches, name matches: shown a card and asked, same as a phone match",
        "Email matches, name doesn't: never shown a card — an email alone is too weak a signal to put a stranger's record in front of anybody, so a new account is made quietly instead and a person reviews it later"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nobody waits on staff",
      "items": [
        "Every path that reaches \"New account\" or \"Linked\" finishes the signup immediately",
        "A tracked duplicate is cheap and reversible \u2014 the person is never the one who pays for an ambiguous match"
      ]
    },
    {
      "dot": "cyan",
      "title": "The person decides what they can",
      "items": [
        "A recognition card only ever shows a redacted record and asks a yes/no question",
        "Saying \"no\" is trusted outright \u2014 it just means the account is made fresh instead of linked"
      ]
    },
    {
      "dot": "rose",
      "title": "Where a person on staff gets involved",
      "items": [
        "Only after the account already works: a declined match, an email match with the wrong name, or more than one record fitting",
        "Being blocked or welcomed back never reaches the queue \u2014 those two are already certain"
      ]
    }
  ]
