{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Proving who you are",
    "subtitle": "The signup handshake — both codes are proved before anything is decided or created",
    "output": "03-signup.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1000,
      1460
    ],
    "views": [
      {
        "id": "email",
        "label": "1 · Email",
        "focus": [
          "visitor",
          "wizard",
          "api",
          "otp",
          "send"
        ],
        "note": "The code is hashed the moment it is issued. Nothing stores it in the clear, and a wrong guess is spent even though the request then fails."
      },
      {
        "id": "phone",
        "label": "2 · Phone",
        "focus": [
          "visitor",
          "wizard",
          "api",
          "otp",
          "send"
        ],
        "note": "The phone is asked for once the email is proved, and always asked for. Turn one channel off and there is no signup at all."
      },
      {
        "id": "resolve",
        "label": "3 · Resolve",
        "focus": [
          "api",
          "match",
          "erp"
        ],
        "note": "The only point where anything is decided, “you already have an account” included. Answering earlier makes the email step a test for it."
      },
      {
        "id": "ask",
        "label": "4 · Ask",
        "focus": [
          "visitor",
          "wizard",
          "api",
          "match"
        ],
        "note": "A record that may be theirs, redacted: street in the clear, governorate and country hidden. The hidden characters never leave the server."
      },
      {
        "id": "create",
        "label": "5 · Create",
        "focus": [
          "wizard",
          "api",
          "link",
          "erp",
          "visitor"
        ],
        "note": "One locked write. Saying no still gives an account: the number is left off the new Contact, recorded as pending, and queued for staff."
      }
    ]
  },
  "participants": [
    {
      "id": "visitor",
      "type": "external",
      "label": "Visitor",
